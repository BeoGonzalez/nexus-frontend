# ==============================================================================
# AWS Cognito Configuration Template
# Copia este archivo como .env.local y completa con los valores de tu entorno.
# ==============================================================================

NEXT_PUBLIC_AWS_REGION=us-east-1
NEXT_PUBLIC_COGNITO_USER_POOL_ID=us-east-1_example
NEXT_PUBLIC_COGNITO_USER_POOL_CLIENT_ID=exampleclientid123456789
NEXT_PUBLIC_COGNITO_DOMAIN=https://your-domain.auth.us-east-1.amazoncognito.com
NEXT_PUBLIC_COGNITO_REDIRECT_SIGN_IN=http://localhost:3000/auth/callback
NEXT_PUBLIC_COGNITO_REDIRECT_SIGN_OUT=http://localhost:3000/


# Hosts EXACTOS de imágenes que puede optimizar /_next/image (coma-separados, sin comodines; se fija en el BUILD).
# Ej.: nexus-lab-assets-123456789012.s3.us-east-1.amazonaws.com  (images.unsplash.com va siempre incluido)
NEXT_PUBLIC_IMAGE_HOSTS=

# Observabilidad (Grafana Cloud). Navegador: colector de Grafana Faro (Frontend Observability -> tu app -> URL).
# Es pública por diseño (no lleva el token) y se fija en el BUILD. Vacío = sin Faro.
NEXT_PUBLIC_FARO_URL=
# Servidor (RUNTIME, los pone el user data de la EC2): trazas OTLP y perfiles hacia la EC2 collector (Alloy).
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
PYROSCOPE_SERVER_ADDRESS=
