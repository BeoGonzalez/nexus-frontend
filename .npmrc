# OWASP A03 — Software Supply Chain
# No ejecutar scripts de ciclo de vida (preinstall/postinstall) de dependencias.
# Los binarios nativos que lo necesiten se aprueban explícitamente con `pnpm approve-builds`.
ignore-scripts=true
# Usar únicamente el registro oficial por HTTPS.
registry=https://registry.npmjs.org/
strict-ssl=true
